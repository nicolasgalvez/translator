[MAIN]
# The modules under test live at the repo root. Pre-commit lints staged files in
# batches, so a batch of only tests/ files would otherwise fail to import them.
source-roots=.

[MESSAGES CONTROL]
disable=
    # This is an app, not a library — docstrings go where they earn their place.
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    # tests/test_chunking.py deliberately mirrors app.py's audio constants; the
    # comment there explains why it can't import them.
    duplicate-code
