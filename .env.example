# Network listener
TRANSLATOR_HOST=127.0.0.1
TRANSLATOR_PORT=8765

# Transcription
TRANSLATOR_MODEL=small
TRANSLATOR_DEVICE="BlackHole 2ch"
# Mic to record (not transcribed): "default", a device name, or blank for none
TRANSLATOR_MIC=
# 1 = record without live transcription; process later from /history
TRANSLATOR_RECORD_ONLY=0
TRANSLATOR_BACKEND=faster-whisper
TRANSLATOR_LANGUAGE=es
